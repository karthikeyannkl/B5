# ============================================================================
# BORNTOWIN5 (B5) — PRODUCTION & STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or configure in Cloudflare Workers / AIC Cloud.
# NEVER commit live secret keys or SMTP passwords to source control or ZIPs.
# ============================================================================

# Server Runtime Port (AIC Cloud / Docker default: 10000)
PORT=10000

# ----------------------------------------------------------------------------
# 1. CLOUDFLARE D1 PERMANENT DATABASE CONFIGURATION (`b5-level-tracking`)
# - In Cloudflare Workers (`src/worker.js`): connected natively via `env.DB`
#   binding in `wrangler.toml` (no API token required inside the Worker).
# - In Node.js / Docker (`server.js` on AIC Cloud): set `CLOUDFLARE_API_TOKEN`
#   (with D1 Edit permission) to connect `server.js` directly to the remote
#   Cloudflare D1 database `b5-level-tracking`.
# ----------------------------------------------------------------------------
CLOUDFLARE_D1_DATABASE_ID=66c93b0f-274f-44df-82f0-b310c7c2acdf
CLOUDFLARE_ACCOUNT_ID=<optional-auto-discovered-if-api-token-has-account-read>
CLOUDFLARE_API_TOKEN=<your-cloudflare-d1-api-token>

# ----------------------------------------------------------------------------
# 2. ADMIN BOOTSTRAP & PORTAL SESSION SECURITY SECRETS
# - If B5_ADMIN_PASSWORD is omitted on a fresh D1 database, the Admin Portal
#   (/admin.html) displays the First-Admin Bootstrap screen to set the initial
#   password without any hardcoded public credentials.
# ----------------------------------------------------------------------------
# B5_ADMIN_PASSWORD=<optional-initial-admin-password>
# B5_ADMIN_BOOTSTRAP_TOKEN=<optional-token-required-for-first-admin-bootstrap>
# B5_AUTH_SECRET=<optional-random-64-char-hex-secret>

# ----------------------------------------------------------------------------
# 3. EXISTING AIC CLOUD SMTP EMAIL CONFIGURATION
# Used for Registration, Login Security, Upgrade Requests, Payment Assignments,
# Proof Submissions, Receiver Confirmations, Final Approvals, and 24h Reminders.
# ----------------------------------------------------------------------------
SMTP_HOST=mail.aiccloud.in
SMTP_PORT=587
SMTP_USER=notifications@borntowin5.com
SMTP_PASS=<your-aic-cloud-smtp-password>
EMAIL_FROM=notifications@borntowin5.com
B5_ADMIN_CONTACT_EMAIL=notifications@borntowin5.com

# ----------------------------------------------------------------------------
# 4. ISOLATED LOCAL / STAGING TEST FLAGS (NEVER ENABLE IN PRODUCTION)
# ----------------------------------------------------------------------------
B5_LOCAL_TEST_ONLY=0
B5_SENIORITY_TEST_MODE=0
