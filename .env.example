# ============================================================================
# BORNTOWIN5 (B5) — PRODUCTION & STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or configure in AIC Cloud / Render host.
# NEVER commit live secret keys or SMTP passwords to source control or ZIPs.
# ============================================================================

# Server Runtime Port (AIC Cloud / Docker default: 10000)
PORT=10000

# ----------------------------------------------------------------------------
# 1. EXISTING SUPABASE PERMANENT DATABASE CONFIGURATION
# Table: public.app_state (id integer primary key = 1, data jsonb not null)
# Do NOT append /rest/v1/ to SUPABASE_URL.
# ----------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<your-supabase-service-role-or-secret-key>

# Optional local cache path (used alongside Supabase or in isolated test mode)
# DB_FILE=./data/db.json

# ----------------------------------------------------------------------------
# 2. EXISTING AIC CLOUD SMTP EMAIL CONFIGURATION
# Used for Registration, Login Security, Upgrade Requests, Payment Assignments,
# Proof Submissions, Receiver Confirmations, Final Approvals, and 24h Reminders.
# ----------------------------------------------------------------------------
SMTP_HOST=mail.aiccloud.in
SMTP_PORT=587
SMTP_USER=notifications@borntowin5.com
SMTP_PASS=<your-aic-cloud-smtp-password>
EMAIL_FROM=notifications@borntowin5.com
B5_ADMIN_CONTACT_EMAIL=notifications@borntowin5.com

# ----------------------------------------------------------------------------
# 3. PORTAL SESSION & RBAC SIGNING SECRET (Optional — auto-derived if omitted)
# ----------------------------------------------------------------------------
# B5_AUTH_SECRET=<optional-random-64-char-hex-secret>

# ----------------------------------------------------------------------------
# 4. ISOLATED LOCAL / STAGING TEST FLAGS (NEVER ENABLE IN PRODUCTION)
# ----------------------------------------------------------------------------
# Set B5_LOCAL_TEST_ONLY=1 ONLY for isolated local/staging testing without Supabase.
B5_LOCAL_TEST_ONLY=0
B5_SENIORITY_TEST_MODE=0
